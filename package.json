{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"dependencies": {
		"assert": "^2.0.0",
		"await-fs": "^1.0.0",
		"concurrently": "^5.3.0",
		"cookie": "^0.7.2",
		"cookie-parser": "~1.4.4",
		"cross-env": "^7.0.2",
		"debug": "~2.6.9",
		"dotenv": "^8.2.0",
		"eslint": "^7.25.0",
		"express": "^4.22.2",
		"express-validator": "^6.5.0",
		"http-errors": "~1.6.3",
		"jsonwebtoken": "^9.0.0",
		"moment": "^2.27.0",
		"morgan": "~1.11.0",
		"multer": "^2.2.0",
		"mysql2": "^3.9.8",
		"react-quill": "^1.3.5",
		"sanitize-html": "^2.17.0",
		"serve": "^14.2.6",
		"validator": "^13.0.0"
	},
	"devDependencies": {
		"eslint-plugin-react": "^7.20.0",
		"nodemon": "^2.0.3",
		"watchman": "^1.0.0",
		"ws": "5.2.5"
	},
	"scripts": {
		"start": "cross-env NODE_ENV=production node app.js",
		"dev": "cross-env NODE_ENV=development concurrently \"npm run serverDev\" \"npm run client\"",
		"dev:debug": "cross-env NODE_ENV=development concurrently \"npm run serverDev:debug\" \"npm run client\"",
		"serverDev": "nodemon app.js --ignore client/*",
		"serverDev:debug": "nodemon --inspect=0.0.0.0:9229 app.js --ignore client/*",
		"client": "cd client && npm start",
		"installAll": "npm install && cd client && npm install",
		"build": "[ -f .env ] && cp -f .env client/.env; cd client && npm run build"
	}
}
