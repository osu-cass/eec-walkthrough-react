# .env.example - Template for required environment variables
# Copy this to .env and fill in values according to README instructions

# Application ports
API_PORT=1111
FILE_PORT=2222

# React app configuration (client)
REACT_APP_API_HOST=http://localhost:1111
NODE_ENV=development

# MariaDB Database and phpMyAdmin configuration
MYSQL_DB_NAME=eec_walkthrough
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=walkthrough

# Sentry error monitoring (optional)
# All of these are read at run time, so changing them only needs a restart.
# Leave both DSNs blank to keep Sentry disabled.
# SENTRY_DSN reports server errors, SENTRY_CLIENT_DSN reports browser errors.
SENTRY_DSN=
SENTRY_CLIENT_DSN=
# Optional: override the environment name reported to Sentry (defaults to NODE_ENV)
SENTRY_ENVIRONMENT=

# Sentry browser source maps (optional, build time only)
# Export these in a trusted build environment. SENTRY_AUTH_TOKEN is a secret and
# must not be committed or passed into the final container image.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
