# .env.example - Template for required environment variables
# Copy this to .env and fill in values according to README instructions

# Application ports
API_PORT=1111
FILE_PORT=2222

# React app configuration (client)
REACT_APP_API_HOST=http://localhost:1111
NODE_ENV=development

# MariaDB Database and phpMyAdmin configuration
MYSQL_DB_NAME=eec_walkthrough
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER= 